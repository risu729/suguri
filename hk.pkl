amends "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/helpers.pkl"

steps = (
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "github-actions"
    "tombi"
    "rumdl"
    "yaml"
    "typos"
    "hygiene"
    "mise"
    "hk-validate"
    "pkl-format"
    "betterleaks"
  })
) {
  ["typos"] {
    // The preset's diff wrapper uses POSIX shell syntax; direct checks work on Windows.
    check_diff = null
  }
  ["pkl-format"] {
    // Use the formatter directly because Windows does not provide the preset's sh.
    shell = null
    fix {
      command = "pkl format --write {{ files }}"
    }
  }
  ["yaml"] {
    steps {
      // mise owns the exact generated lockfile layout for installed tools.
      ["yamllint"] {
        exclude = helpers.yamlLockExcludes + List(".mise/locks/**")
      }
      ["yamlfmt"] {
        exclude = helpers.yamlLockExcludes + List(".mise/locks/**")
      }
    }
  }
}

hooks {
  ["check"] {
    steps {
      ["typecheck"] = new Step {
        check = "mise run typecheck"
      }
    }
  }
}
